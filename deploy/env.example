# =============================================================================
# Enterprise ROI Engine - Environment Configuration
# =============================================================================
# Copy to .env and fill in values for local development
# Production values are managed via Secret Manager

# -----------------------------------------------------------------------------
# Core Service Configuration
# -----------------------------------------------------------------------------
NODE_ENV=development
PORT=8080
PLATFORM_ENV=dev
SERVICE_NAME=enterprise-roi-engine
SERVICE_VERSION=0.1.0

# -----------------------------------------------------------------------------
# ruvector-service Integration (REQUIRED)
# All persistence MUST occur via ruvector-service
# -----------------------------------------------------------------------------
RUVECTOR_SERVICE_URL=https://ruvvector-service-1062287243982.us-central1.run.app
RUVECTOR_API_KEY=

# -----------------------------------------------------------------------------
# Telemetry & Observability
# -----------------------------------------------------------------------------
TELEMETRY_ENDPOINT=https://llm-observatory-1062287243982.us-central1.run.app
TELEMETRY_ENABLED=true

# -----------------------------------------------------------------------------
# Platform Integration URLs (Read-only, for reference)
# -----------------------------------------------------------------------------
# Analytics Hub: https://llm-analytics-hub-1062287243982.us-central1.run.app
# CostOps: https://llm-costops-1062287243982.us-central1.run.app
# Research Lab: https://llm-research-lab-1062287243982.us-central1.run.app
# Platform: https://agentics-platform-1062287243982.us-central1.run.app
